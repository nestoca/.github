# Slack Configuration
# Get your bot token from https://api.slack.com/apps
# Required scopes: channels:history, groups:history, users:read, conversations.list
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Confluence Configuration
# Get API token from https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_USERNAME=your-email@nestoca.ca
CONFLUENCE_API_TOKEN=your-api-token-here
CONFLUENCE_URL=https://nestoca.atlassian.net
